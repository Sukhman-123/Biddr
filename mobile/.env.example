# Public values are embedded in the application bundle. Never put secrets here.
#
# iOS simulator / Expo web on this Mac:
EXPO_PUBLIC_API_URL=http://127.0.0.1:5001/api
EXPO_PUBLIC_SOCKET_URL=http://127.0.0.1:5001

# A physical phone must use your Mac's LAN IP or a deployed HTTPS API instead:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:5001/api
# EXPO_PUBLIC_SOCKET_URL=http://192.168.1.10:5001
